{
  "name": "xterm-web-terminal",
  "version": "1.63.0",
  "main": "dist/server.js",
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts --no-open",
    "test": "npm run build && cd test && go test -v -count=1 ./...",
    "test:unit": "node --import tsx --test test-unit/*.test.ts test-unit/agentTokens/*.test.ts"
  },
  "dependencies": {
    "express": "^4.18.3",
    "node-pty": "^1.0.0",
    "selfsigned": "^2.4.1",
    "tar-stream": "^3.1.7",
    "ws": "^8.17.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.5.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
